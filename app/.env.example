# GitHub OAuth App 설정
# 1. https://github.com/settings/developers 접속
# 2. "New OAuth App" 클릭
# 3. Homepage URL: http://localhost:3000
# 4. Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# MongoDB 연결 URI
MONGODB_URI=mongodb://localhost:27017/todo-app

# 세션 암호화 키 (최소 32자 이상의 무작위 문자열)
# 생성 예: openssl rand -base64 32
SESSION_SECRET=your_session_secret_at_least_32_characters_long

# 앱 기본 URL (개발환경)
NEXTAUTH_URL=http://localhost:3000
